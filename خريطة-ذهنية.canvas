{
	"nodes":[
		{"id":"center","type":"text","text":"# Deep Learning for Computer Vision (CS231n)\n\n## الملخص الشامل لكورس الرؤية الحاسوبية والتعلم العميق","x":1000,"y":610,"width":340,"height":120,"color":"6"},
		{"id":"l1","type":"text","text":"## المحاضرة 1\nتصنيف الصور و k-NN","x":480,"y":70,"width":260,"height":80,"color":"1"},
		{"id":"l1c1","type":"text","text":"تصنيف الصور: إعطاء صورة تسمية واحدة من فئات ثابتة","x":40,"y":20,"width":240,"height":50},
		{"id":"l1c2","type":"text","text":"الصورة = مصفوفة 3D أرقام 0-255 (عرض × ارتفاع × RGB)","x":40,"y":85,"width":240,"height":50},
		{"id":"l1c3","type":"text","text":"النهج القائم على البيانات: تعلّم من أمثلة لا قواعد","x":40,"y":150,"width":240,"height":50},
		{"id":"l1c4","type":"text","text":"k-NN: أقرب k صور تصوّت — مسافات L1 / L2 (CIFAR-10)","x":40,"y":215,"width":240,"height":50},
		{"id":"l1c5","type":"text","text":"ضبط المعاملات: Validation Set + Cross-Validation (القاعدة الذهبية)","x":40,"y":280,"width":240,"height":50},
		{"id":"l2","type":"text","text":"## المحاضرة 2\nالتصنيف الخطي (Linear Classification)","x":480,"y":420,"width":260,"height":90,"color":"2"},
		{"id":"l2c1","type":"text","text":"النهج المعاملي: f(x,W,b) = W·x + b — تعلّم الأوزان ورمي البيانات","x":40,"y":380,"width":240,"height":50},
		{"id":"l2c2","type":"text","text":"كل صف في W = قالب (Template) لفئة — أعلى درجة = التنبؤ","x":40,"y":445,"width":240,"height":50},
		{"id":"l2c3","type":"text","text":"SVM Loss (Hinge): max(0, s_j - s_yi + Δ) — يتوقف عند Δ","x":40,"y":510,"width":240,"height":50},
		{"id":"l2c4","type":"text","text":"Softmax Loss: تحويل لاحتمالات + Cross-Entropy — يزيد الثقة دائماً","x":40,"y":575,"width":240,"height":50},
		{"id":"l2c5","type":"text","text":"التنظيم: L = Data Loss + λ·R(W) — يعاقب الأوزان الكبيرة","x":40,"y":640,"width":240,"height":50},
		{"id":"l3","type":"text","text":"## المحاضرة 3\nالتحسين (Optimization)","x":480,"y":790,"width":260,"height":90,"color":"3"},
		{"id":"l3c1","type":"text","text":"البحث العشوائي (15.5%) → البحث المحلي (21.4%) → اتباع التدرج","x":40,"y":750,"width":240,"height":50},
		{"id":"l3c2","type":"text","text":"Gradient = متجه المشتقات الجزئية — يشير للصعود فنمشي بعكسه","x":40,"y":815,"width":240,"height":50},
		{"id":"l3c3","type":"text","text":"Numerical (بطيء، للـ Gradient Check) vs Analytic (سريع، للاستخدام)","x":40,"y":880,"width":240,"height":50},
		{"id":"l3c4","type":"text","text":"Gradient Descent: W += - step_size × ∇L","x":40,"y":945,"width":240,"height":50},
		{"id":"l3c5","type":"text","text":"Learning Rate = أهم معامل فائق (صغير بطيء، كبير ينفجر)","x":40,"y":1010,"width":240,"height":50},
		{"id":"l3c6","type":"text","text":"Mini-batch (32-256): تقريب جيد للتدرج — قوى 2 للسرعة","x":40,"y":1075,"width":240,"height":50},
		{"id":"2de934c8919d8f69","x":945,"y":1105,"width":250,"height":60,"type":"text","text":""},
		{"id":"l5c5","type":"text","text":"التعلم الهرمي: حواف بسيطة → أجزاء معقدة (عيون)","x":2040,"y":675,"width":250,"height":50},
		{"id":"l5c6","type":"text","text":"Translation Equivariance: Conv(Translate(X)) = Translate(Conv(X))","x":2040,"y":740,"width":250,"height":50},
		{"id":"l5c7","type":"text","text":"التاريخ: LeNet (1998) → AlexNet (2012) → Transformers (2021)","x":2040,"y":805,"width":250,"height":50},
		{"id":"l5c3","type":"text","text":"معادلة الأبعاد: Output = (W-K+2P)/S + 1","x":2040,"y":545,"width":250,"height":50},
		{"id":"l5c4","type":"text","text":"ReLU (max(0,x)) + Max Pooling (تصغير) + FC (تصنيف)","x":2040,"y":610,"width":250,"height":50},
		{"id":"l5c2","type":"text","text":"Conv: فلاتر صغيرة تنزلق + Parameter Sharing","x":2040,"y":480,"width":250,"height":50},
		{"id":"l5c1","type":"text","text":"مشكلة Linear: flatten يضيع البنية المكانية للصورة","x":2040,"y":415,"width":250,"height":50},
		{"id":"l6c2","type":"text","text":"دوال التنشيط: ReLU (الأفضل)، GELU، Leaky ReLU، ELU","x":2040,"y":990,"width":250,"height":50},
		{"id":"l6c3","type":"text","text":"المعماريات: VGG (فلاتر 3×3) + ResNet (Skip Connections)","x":2040,"y":1055,"width":250,"height":50},
		{"id":"l6c4","type":"text","text":"Kaiming Init: std = √(2/D_in) لـ ReLU","x":2040,"y":1120,"width":250,"height":50},
		{"id":"l6c5","type":"text","text":"التعلم بالنقل: ImageNet pretrained + Finetune حسب بياناتك","x":2040,"y":1185,"width":250,"height":50},
		{"id":"l6c6","type":"text","text":"زيادة البيانات: Flips / Crops / Color Jitter + TTA","x":2040,"y":1250,"width":250,"height":50},
		{"id":"l6c7","type":"text","text":"ضبط المعاملات: تحقق الخسارة → Overfit صغير → ابحث عن LR → Random Search","x":2040,"y":1315,"width":250,"height":50},
		{"id":"l6c1","type":"text","text":"الطبقات: Conv + Normalization + Pool + Dropout","x":2040,"y":920,"width":250,"height":50},
		{"id":"l6","type":"text","text":"## المحاضرة 6\nبناء وتدريب CNNs","x":1540,"y":1015,"width":260,"height":90,"color":"6"},
		{"id":"l5","type":"text","text":"## المحاضرة 5\nالشبكات التلافيفية (CNNs)","x":1540,"y":530,"width":260,"height":80,"color":"5"},
		{"id":"l4c4","type":"text","text":"Max Gate: يوجّه التدرج للمدخل الأكبر فقط","x":2040,"y":15,"width":250,"height":50},
		{"id":"l4c5","type":"text","text":"Sigmoid: σ'(x) = σ(x)(1-σ(x)) — سر حسابي جميل","x":2040,"y":80,"width":250,"height":50},
		{"id":"l4c6","type":"text","text":"المتغير المتفرع: اجمع التدرجات (+= لا =)","x":2040,"y":145,"width":250,"height":50},
		{"id":"l4c7","type":"text","text":"تحليل الأبعاد (Dimension Analysis) بدل حفظ الصيغ","x":2040,"y":225,"width":250,"height":50},
		{"id":"l4","type":"text","text":"## المحاضرة 4\nالانتشار العكسي (Backpropagation)","x":1540,"y":-50,"width":260,"height":90,"color":"4"},
		{"id":"l4c1","type":"text","text":"قاعدة السلسلة + تدفق التدرجات للخلف (Circuit)","x":2040,"y":-220,"width":250,"height":60},
		{"id":"l4c2","type":"text","text":"Add Gate: يوزّع التدرج بالتساوي على المدخلات","x":2040,"y":-140,"width":250,"height":60},
		{"id":"l4c3","type":"text","text":"Mul Gate: يقلب المدخلات (dz/dx = y)","x":2040,"y":-65,"width":250,"height":50}
	],
